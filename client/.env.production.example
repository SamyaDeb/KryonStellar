# Build-time environment for the web tier — copy to .env.production.local and
# fill in. Used by ship-web-tier.sh when it runs `next build`.
#
# Everything NEXT_PUBLIC_* here is inlined into the browser bundle by static
# textual substitution at build time. It is therefore the BUILD machine's env
# that reaches users, not the server's — which is why this file exists separately
# from the .env.local that lives on the box.
#
# Kryon runs on Stellar TESTNET only. Contract and asset addresses are NOT set
# here: the testnet v4 set baked into config/networks.ts applies. Leaving the
# old NEXT_PUBLIC_CONTRACT_* lines in place is how a stale contract set reaches
# a build, so delete them rather than commenting them out.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_APP_URL=https://kryonprotocol.live

# Set to false while the keeper fleet is down so traders see the paused banner
# instead of an order book that silently never fills.
NEXT_PUBLIC_TESTNET_KEEPERS_LIVE=true

# The ws-server process that tails the testnet database. Also becomes the CSP
# connect-src allowlist entry.
NEXT_PUBLIC_WS_URL=wss://ws-testnet.kryonprotocol.live

# Only markets registered on the v4 engine can accept orders. As of 2026-11-11
# only XLM-PERP (market 1) is registered; run
#   npx tsx --env-file=.env.testnet scripts/add-market.ts --all --execute
# and then widen this list.
NEXT_PUBLIC_ACTIVE_MARKETS=XLM-PERP
